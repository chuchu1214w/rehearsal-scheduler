# 全部可选;本机运行不需要任何配置。上线时复制为 .env 并按需修改(.env 不会提交到仓库)。
# DATABASE_URL=sqlite:////absolute/path/to/app.db      # 或 postgresql+psycopg://user:pass@host/db
# APP_TIMEZONE=Asia/Seoul
# PUBLIC_BASE_URL=https://your-domain.example         # 生成日历订阅链接时使用(手机要能访问到这个地址)
# COOKIE_SECURE=true                                   # 启用 HTTPS 后设为 true
# SESSION_DAYS=14
# INVITE_DAYS=7
