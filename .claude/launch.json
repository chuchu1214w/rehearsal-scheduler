{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app-running",
      "url": "http://localhost:8000"
    },
    {
      "name": "backend",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": [
        "app.asgi:app",
        "--app-dir",
        "backend",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "backend-demo",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "DATABASE_URL=sqlite:///data/demo.db SOLVER_WORKERS=4 exec .venv/bin/uvicorn app.asgi:app --app-dir backend --port 8001"
      ],
      "port": 8001
    }
  ]
}